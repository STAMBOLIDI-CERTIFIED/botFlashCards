# Скопируйте в .env и подставьте свои значения
DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=8000
SEED_ON_START=1
BOT_TOKEN=
WEBAPP_URL=
# Приватность бота: ID владельца и/или список через запятую.
# Пусто = бот отвечает всем. Пример: OWNER_ID=123456789
OWNER_ID=
ALLOWED_USER_IDS=
DATA_DIR=/app/data
